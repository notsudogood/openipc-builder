#
# MI libraries waybeam's Maruko backend never opens (maruko_mi.c dlopens
# sys, vif, sensor, venc, isp, scl, ai, cam_os_wrapper, mi_common, ispalgo,
# cus3a and rgn; ive only with framing = "stab", which this image builds
# without). Kept: everything on that list.
/usr/lib/libMD_LINUX.so
/usr/lib/libmi_ao.so
/usr/lib/libmi_ipu.so
/usr/lib/libmi_iqserver.so
/usr/lib/libmi_ive.so
/usr/lib/libmi_shadow.so
/usr/lib/libmi_vdf.so
#
# The MI stack is loaded by maburd (load_sigmastar -i from S00mabur, as on
# the SSC338Q); the stock S70vendor must not run it a second time.
/etc/init.d/S70vendor
